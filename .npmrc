# Use a flat (npm-like) node_modules instead of pnpm's deeply-nested
# .pnpm/<long-hash>/node_modules/ layout. On Windows that nesting pushes
# React Native native-module build paths (react-native-screens etc.) past the
# 260-char MAX_PATH limit, breaking `gradlew assembleRelease`. A flat layout
# keeps those paths short. Remove this file + re-run `pnpm install` to revert.
node-linker=hoisted
