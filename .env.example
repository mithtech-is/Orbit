NODE_ENV=development

DATABASE_URL=postgres://fieldsales:fieldsales@localhost:15432/fieldsales
POSTGRES_DB=fieldsales
POSTGRES_USER=fieldsales
POSTGRES_PASSWORD=fieldsales
POSTGRES_PORT=15432

REDIS_URL=redis://localhost:6379

MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_JWT_SECRET=replace-with-local-jwt-secret
MEDUSA_COOKIE_SECRET=replace-with-local-cookie-secret

NEXT_PUBLIC_API_BASE_URL=http://localhost:9000
NEXT_PUBLIC_WS_URL=ws://localhost:9000
NEXT_PUBLIC_MAP_PROVIDER=mock
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-side maps provider — used by route-planning. One of: mock | mapbox | google | osrm.
# PRODUCTION: must be a real provider (the backend refuses to boot on `mock`).
# `osrm` is the recommended free default — set OSRM_USER_AGENT below (and optionally
# self-host OSRM_BASE_URL / NOMINATIM_BASE_URL for scale).
MAP_PROVIDER=mock
# Required when MAP_PROVIDER=mapbox
MAPBOX_TOKEN=
# Required when MAP_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Required when MAP_PROVIDER=osrm (Nominatim usage policy demands a real User-Agent / contact)
OSRM_USER_AGENT=Orbit/1.0 (+https://orbit.app)
# Optional self-hosted overrides
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

MOBILE_API_BASE_URL=http://localhost:9000
MOBILE_WS_URL=ws://localhost:9000

# --- Live tracking freshness / session hygiene ---
# A rep only shows on the live team map while their last ping is newer than this
# many seconds (default 300 = 5 min). Mobile pings every ~20s, so this tolerates
# a few dropped pings without showing a rep whose app died. Keep the dashboard's
# NEXT_PUBLIC_TRACKING_LIVE_WINDOW_SECONDS in sync with this value.
TRACKING_LIVE_WINDOW_SECONDS=300
NEXT_PUBLIC_TRACKING_LIVE_WINDOW_SECONDS=300
# An `active` session with no ping for this long is auto-stopped as abandoned
# (default 900 = 15 min). Must be >= TRACKING_LIVE_WINDOW_SECONDS.
SESSION_STALE_AFTER_SECONDS=900
# Auto-expiry sweep: on by default in production, opt-in in dev.
SESSION_EXPIRY_ENABLED=false
SESSION_EXPIRY_INTERVAL_MS=60000

OBJECT_STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_ROOT=.local/object-storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PUSH_PROVIDER=log
FCM_SERVER_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Outbound email (password reset, invites). "log" prints to stdout; "smtp" sends
# via nodemailer (run `pnpm --filter @fieldsales/backend-medusa add nodemailer`).
EMAIL_PROVIDER=log
EMAIL_FROM=RoutePilot <no-reply@routepilot.local>
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Uploads (visit photos / attachments). Max accepted size for a single upload.
MAX_UPLOAD_BYTES=8388608
# Public base URL for S3 objects when OBJECT_STORAGE_PROVIDER=s3 (optional).
S3_PUBLIC_BASE_URL=

# --- ERPNext + Frappe CRM (lead capture) integration ---
# DORMANT, opt-in plugin. With ERPNEXT_ENABLED=false the connector is a no-op.
# BASE_URL points at the SEPARATE instance stood up for RoutePilot (Compose
# project `routepilot-crm`, site crm.localhost, port 8082 — see infra/erpnext-crm/).
# It is isolated from any other ERPNext you run; the connector only calls BASE_URL.
# Captured leads (/api/v1/leads) mirror to the CRM Lead doctype best-effort.
ERPNEXT_ENABLED=false
ERPNEXT_BASE_URL=http://localhost:8082
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=
ERPNEXT_CURRENCY=INR
ERPNEXT_CUSTOMER_GROUP=Commercial
ERPNEXT_TERRITORY=All Territories
ERPNEXT_CRM_LEAD_SOURCE=Walk In
ERPNEXT_CRM_DEFAULT_LEAD_STATUS=New
ERPNEXT_TIMEOUT_MS=10000
# Two-way sync: shared secret the CRM Webhook must send in the
# X-RoutePilot-Webhook-Secret header to POST /api/v1/integrations/erp/webhook.
ERPNEXT_WEBHOOK_SECRET=

SENTRY_DSN=
LOG_LEVEL=debug

ELECTRON_UPDATER_PROVIDER=none
ELECTRON_UPDATE_URL=

DEMO_ORG_SLUG=acme-field-sales
DEMO_ADMIN_EMAIL=admin@acme-fieldsales.test
DEMO_MANAGER_EMAIL=manager@acme-fieldsales.test
DEMO_OPERATIONS_EMAIL=ops@acme-fieldsales.test
DEMO_REP_PASSWORD=ChangeMe123!

# Dashboard dev auth headers (used by api-service.ts to call backend scaffold)
NEXT_PUBLIC_DEMO_USER_ID=user_admin
NEXT_PUBLIC_DEMO_ORG_ID=org_acme
NEXT_PUBLIC_DEMO_ROLE=organisation_admin
NEXT_PUBLIC_DEMO_PERMISSIONS=organisation:manage,user:manage,policy:manage
